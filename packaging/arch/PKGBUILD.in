pkgname=varpaper
pkgver=@VERSION@
pkgrel=1
pkgdesc='Animated wallpaper manager for Linux'
arch=('x86_64')
url='https://github.com/mybna134/VarPaper'
license=('GPL-3.0-only')
options=('!debug')
makedepends=('python')
depends=(
  'alsa-lib'
  'ayatana-ido'
  'ca-certificates'
  'gcc-libs'
  'glibc'
  'fontconfig'
  'gtk3'
  'libayatana-appindicator'
  'libayatana-indicator'
  'libcups'
  'libglvnd'
  'libpulse'
  'libx11'
  'libxcomposite'
  'libxdamage'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'mpv'
  'nspr'
  'nss'
  'openssl'
  'sdl2'
  'ttf-dejavu'
  'wayland'
)
source=(
  'varpaper-bundle.tar.zst'
  'varpaper.desktop'
  'varpaper.png'
  'LICENSE'
  'NOTICE'
  'LICENSE-APACHE'
  'LICENSE-MIT'
  'check-linux-bundle.py'
  'runtime.json'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -d "$pkgdir/usr/lib/varpaper"
  tar --zstd -xf "$srcdir/varpaper-bundle.tar.zst" -C "$pkgdir/usr/lib/varpaper"
  # The transitive jni Flutter plugin is unused on Linux and links to libjvm.
  rm -f "$pkgdir/usr/lib/varpaper/lib/libdartjni.so"

  install -Dm644 "$srcdir/varpaper.desktop" \
    "$pkgdir/usr/share/applications/io.github.mybna134.varpaper.desktop"
  install -Dm644 "$srcdir/varpaper.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/io.github.mybna134.varpaper.png"
  install -Dm644 "$srcdir/varpaper.png" \
    "$pkgdir/usr/lib/varpaper/packaging/varpaper.png"
  install -Dm644 "$srcdir/LICENSE" \
    "$pkgdir/usr/share/licenses/varpaper/LICENSE"
  install -Dm644 "$srcdir/NOTICE" \
    "$pkgdir/usr/share/licenses/varpaper/NOTICE"
  install -Dm644 "$srcdir/LICENSE-APACHE" \
    "$pkgdir/usr/share/licenses/varpaper/LICENSE-APACHE"
  install -Dm644 "$srcdir/LICENSE-MIT" \
    "$pkgdir/usr/share/licenses/varpaper/LICENSE-MIT"

  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/varpaper" <<'EOF'
#!/bin/sh
cd /usr/lib/varpaper
exec ./wayvid-gui "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/varpaper"

  # Check in the target distribution without inheriting a developer CEF path.
  python "$srcdir/check-linux-bundle.py" "$pkgdir/usr/lib/varpaper" \
    --manifest "$srcdir/runtime.json"
}
