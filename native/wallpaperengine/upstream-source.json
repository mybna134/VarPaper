{
  "repository": "https://github.com/Almamu/linux-wallpaperengine",
  "revision": "b016d7d1fdcf4e5fd2f9c9fa420a8aaa07fee02d",
  "adaptations": [
    "Trimmed CLI/application/desktop/browser sources; retained Scene animated-video texture playback",
    "CWallpaper factory selects Scene only; VarPaper supplies application/output adapters",
    "Added exact bounded binary reads and texture allocation/decompression limits",
    "Replaced Scene object ownership with unique_ptr and rejected cyclic dependencies; propagate setup failures",
    "Fixed SDL device/stream/mutex cleanup and added synchronized playback controls",
    "Removed noexcept from throwing JSON conversions; added explicit includes and integer casts for standalone C++20 compilation",
    "Made sound queues nonblocking in SDL callbacks, fixed atomic producer state, FFmpeg/SDL cleanup on partial initialization, packet ownership and output-channel resampling",
    "Added QuickJS memory/stack/execution limits, module namespace evaluation and script failure propagation; bounded text raster sizes and clock-based timers",
    "Reject unsupported required Scene objects and bound aggregate texture/encoded-image allocations before allocation; clean partial GL texture initialization"
  ],
